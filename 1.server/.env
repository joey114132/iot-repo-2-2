DB_NAME=smart_parking

# UDP 수신 포트 (ESP32 -> 서버 영상/데이터 전송)
UDP_HOST=0.0.0.0
UDP_PORT=9000

# 주차장 운영 상태 기본값 (true=운영중, false=운영종료)
OPERATION_MODE_ON=true

# 차단기 상태 기본값
# 0: 연결안됨, 1: 닫힘, 2: 열림, 3: 자동
GATE_SENSOR_STATE=1
# 자동 모드일 때 실제 동작 상태
# 0: 동작하지 않음, 1: 열림, 2: 닫힘
GATE_AUTO_STATE=2

